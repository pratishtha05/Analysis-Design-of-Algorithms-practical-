//Activity Selection
#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;

struct Job {
    int id, deadline, profit;
};

bool compare(Job a, Job b) {
    return a.profit > b.profit;
}

void actSelection(Job jobs[], int numJobs, int numSlots) {
    sort(jobs, jobs + numJobs, compare);

    vector<int> slots(numSlots, -1);
    
    int totalProfit = 0;

    for (int j = 0; j < numJobs; j++) {
        for (int i = min(numSlots, jobs[j].deadline) - 1; i >= 0; i--) {
            if (slots[i] == -1) { 
                slots[i] = jobs[j].id;
                totalProfit += jobs[j].profit;
                break;
            }
        }
    }

    cout << "Scheduled Jobs: ";
    for (int i = 0; i < numSlots; i++) {
        if (slots[i] != -1) cout << "J" << slots[i] << " ";
    }
    cout << "\nTotal Profit: " << totalProfit << endl;
}

int main() {
    Job jobs[] = {
        {1, 2, 100}, {2, 1, 50}, {3, 2, 10}, {4, 1, 20}, {5, 3, 30}
    };
    int numJobs = sizeof(jobs) / sizeof(jobs[0]);
    int numSlots = 3; 

    actSelection(jobs, numJobs, numSlots);
    return 0;
}

