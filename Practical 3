//Knapsack problem (greedy approach)
#include <iostream>
#include <algorithm>

using namespace std;

struct Item {
    int weight, value;
};

bool compareByWeight(Item a, Item b) {
    return a.weight < b.weight;
}

bool compareByValue(Item a, Item b) {
    return a.value > b.value;
}

bool compareByRatio(Item a, Item b) {
    return (double)a.value / a.weight > (double)b.value / b.weight;
}

double knapsackGreedy(Item* items, int n, int capacity, bool (*compare)(Item, Item)) {
    sort(items, items + n, compare);
    double totalValue = 0.0;
    
    for (int i = 0; i < n && capacity > 0; i++) {
        int take = min(capacity, items[i].weight);
        totalValue += (double)items[i].value * take / items[i].weight;
        capacity -= take;
    }
    return totalValue;
}

int main() {
    int n, capacity;
    cin >> n >> capacity;
    Item* items = new Item[n];  // Dynamic allocation

    for (int i = 0; i < n; i++)
        cin >> items[i].weight >> items[i].value;

    cout << knapsackGreedy(items, n, capacity, compareByWeight) << " ";
    cout << knapsackGreedy(items, n, capacity, compareByValue) << " ";
    cout << knapsackGreedy(items, n, capacity, compareByRatio) << endl;

    delete[] items; // Free memory
    return 0;
}
