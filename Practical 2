void initialize(int *arr,int n){
    for (int i = 0; i < n; i++)
    {
        arr[i]=(rand()%n+1);
    }
}

void insertionSort(int n){
    //initialization
    int *arr = new int[n];
    initialize(arr,n);
    

    for (int j=1; j<n; j++){
        int key=arr[j];
        int i=j-1;
        while (i>=0 && arr[i]>key)
        {
            arr[i+1]=arr[i];
            i--;
            
        }
        arr[i+1]=key;
        
    }
}

