using namespace std;

void initialize(int *arr,int n){
    for (int i = 0; i < n; i++)
    {
        arr[i]=(rand()%n+1);
    }
}

void selectionSort(int n){
    int *arr = new int[n];
    initialize(arr,n);

    for (int i=0;i<n;i++)
    {
        int min=i;
        for (int j = 0; j < n; j++)
        {
            if(arr[j]<arr[min]){
                min=j;
            }
        }
        int temp = arr[min];
        arr[min]=arr[i];
        arr[i]=temp;
        
    }
    

}

int main(){
