// Bubble sort
#include <iostream>
#include <string>
#include<ctime>
#include <cmath>
#include <math.h>
#include <iomanip>
#include <chrono>
#include <fstream>
#include<random>
using namespace std::chrono;
using namespace std;

void initialize(int *arr,int n){
    for (int i = 0; i < n; i++)
    {
        arr[i]=(rand()%n+1);
    }
}

void bubbleSort(int n){
    int *arr = new int[n];
    initialize(arr,n);

    for (int i=n-1; i>=0;i--)
    {
        for(int j=0; j<=i-1;j++){
            if(arr[j]>arr[j+1]){
                int temp = arr[j];
                arr[j]=arr[j+1];
                arr[j+1]=temp;
            }
        }
    }
    

}

int main(){
    //time complexity
    int sizes[10];
    double times[10];
    int size = 4;

    for (int i = 0; i < 10; i++)
    {
        sizes[i]=size;
        auto start = high_resolution_clock::now();
        for(int i=0; i<100;i++){
            bubbleSort(size);
        }
        auto end = high_resolution_clock::now();
        auto duration = duration_cast<nanoseconds>(end - start);
        double avg = static_cast<long double>((duration.count())/100);
        times[i]=avg;
        size = size * 3;
        cout<<size;
    }
    
    ofstream fout("valuesBubbleSort.csv");
    fout << "size:"<<endl;
    for(int i=0; i<10; i++){
        fout<<sizes[i]<<", ";
    }
    fout<<endl;
    fout << "time:"<<endl;
    for(int i=0; i<10; i++){
        fout<<times[i]<<", ";
    }
    fout.close();


    return 0;
}

