//quick sort
#include <iostream>
#include <cstdlib>
#include <ctime>
#include <chrono>
#include <fstream>
using namespace std;
using namespace std::chrono;

int partition(int *arr, int s, int e){
    int pivot = arr[s];
    int i = s, j = e;
    while (i < j) {
        while (arr[i] <= pivot && i < e)
            i++;
        while (arr[j] > pivot && j > s)
            j--;
        if (i < j)
            swap(arr[i], arr[j]);
    }
    swap(arr[s], arr[j]);
    return j;
}

void quickSort(int *arr, int s, int e) {
    if (s >= e) return;
    int p = partition(arr, s, e);
    quickSort(arr, s, p - 1);
    quickSort(arr, p + 1, e);
}

int main() {
    srand(time(0)); // Seed for random number generation
    cout << "Enter size of array: ";
    int n;
    cin >> n;
    int *arr = new int[n];
    
    cout << "Generated random array: ";
    for (int i = 0; i < n; i++) {
        arr[i] = rand() % 100; // Generating random numbers between 0-99
        cout << arr[i] << " ";
    }
    cout << endl;
    
    quickSort(arr, 0, n - 1);
    
    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
    
    // Measuring time complexity
    int sizes[10];
    double times[10];
    int size = 100;

    for (int i = 0; i < 10; i++) {
        sizes[i] = size;
        auto start = high_resolution_clock::now();
        for (int j = 0; j < 100; j++) {
            int *tempArr = new int[size];
            for (int k = 0; k < size; k++) {
                tempArr[k] = rand() % 100;
            }
            quickSort(tempArr, 0, size - 1);
            delete[] tempArr;
        }
        auto end = high_resolution_clock::now();
        auto duration = duration_cast<nanoseconds>(end - start);
        double avg = static_cast<long double>((duration.count()) / 100);
        times[i] = avg;
        size = size * 3;
    }
    
    ofstream fout("valuesQuickSort.csv");
    fout << "size:" << endl;
    for (int i = 0; i < 10; i++) {
        fout << sizes[i] << ", ";
    }
    fout << endl;
    fout << "time:" << endl;
    for (int i = 0; i < 10; i++) {
        fout << times[i] << ", ";
    }
    fout.close();
    
    delete[] arr; // Free allocated memory
    return 0;
}

