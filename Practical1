    // };

    //making the dictionary
    ifstream in("docA.txt");
    string st;

    map<int, string> dict;
    int i = 1;

    while (in >> st) { 
        if (stopWords.count(st) == 0 ) {
            dict[i] = st; 
            i++;
        }
    }
    in.close();
    // printing dictionary  
    cout<<"the dictionary:"<<endl;
    for (const auto& it : dict) {
        cout << it.first << ": " << it.second << endl;
    }


    // calculating freq for A
    vector<int> wordsFreqA(dict.size(), 0);
    ifstream inA("docA.txt");
    string stA;

    while (inA >> stA) {
        
            for (auto it = dict.begin(); it != dict.end(); it++) {
                if (it->second == stA) {
                    int index = it->first - 1; 
                    wordsFreqA[index]++; 
                    break;
                }
            }
        
    }
    inA.close();
    //printing freq vector A
    cout<<"freq vector A:"<<endl;
    for (int freq : wordsFreqA) {
        cout << freq << " ";
    }
    cout << endl;

    //calculating freq for B
    vector<int> wordsFreqB(dict.size(), 0);
    ifstream inB("docB.txt");
    string stB;

    while (inB >> stB) {
        
            for (auto it = dict.begin(); it != dict.end(); it++) {
                if (it->second == stB) {
                    int index = it->first - 1; 
                    wordsFreqB[index]++; 
                    break;
                }
            }
        
    }
    inB.close();
    //printing freq vector B
    cout<<"freq vector B:"<<endl;
    for (int freq : wordsFreqB) {
        cout << freq << " ";
    }
    cout << endl;


    // dot product
    float dotA_B = 0;
    for (int i = 0; i < dict.size(); i++) {
        dotA_B += wordsFreqA[i] * wordsFreqB[i];
    }
    cout<<"dot product:"<<dotA_B<<endl;

    // magnitudes
    float modA = 0, modB = 0;
    for (int i = 0; i < dict.size(); i++) {
        modA += wordsFreqA[i] * wordsFreqA[i];
        modB += wordsFreqB[i] * wordsFreqB[i];
    }
    cout<<"mag of a: "<<modA<<" "<<" mag of b: "<<modB<<endl;

    cout<<"sqrt values:"<<endl;
    modA = (sqrt(modA));
    modB = (sqrt(modB));
    cout<<"mag of a: "<<modA<<" "<<" mag of b: "<<modB<<endl;

    float denom = modA * modB;

    // calculating similarity
    if (denom != 0) {
        double similarity = dotA_B / denom;
        
        double similarityPercentage = similarity * 100;
        cout << "Similarity Percentage: " << similarityPercentage << "%" << endl;
    } else {
        cout << "No similarity due to zero denominator." << endl;
    }


    return 0;
}


